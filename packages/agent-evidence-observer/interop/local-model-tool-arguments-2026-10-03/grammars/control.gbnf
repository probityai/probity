abstain-kv ::= "\"abstain\"" space ":" space boolean
arguments ::= "{" space arguments-key-kv "," space arguments-value-kv "}" space
arguments-key ::= string | integer | number | boolean | null | array | arguments-key-6
arguments-key-6 ::= object
arguments-key-kv ::= "\"key\"" space ":" space arguments-key
arguments-kv ::= "\"arguments\"" space ":" space arguments
arguments-value ::= string | integer | number | boolean | null | array | arguments-value-6
arguments-value-6 ::= object
arguments-value-kv ::= "\"value\"" space ":" space arguments-value
array ::= "[" space ( value ("," space value)* )? "]" space
boolean ::= ("true" | "false") space
char ::= [^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
decimal-part ::= [0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
integer ::= ("-"? integral-part) space
integral-part ::= [0-9] | [1-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
null ::= "null" space
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)? space
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? "}" space
root ::= "{" space tool-kv "," space arguments-kv "," space abstain-kv "}" space
space ::= " "?
string ::= "\"" char* "\"" space
tool-kv ::= "\"tool\"" space ":" space string
value ::= object | array | string | number | boolean | null