amount-kv ::= "\"amount\"" space ":" space integer
char ::= [^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
currency-kv ::= "\"currency\"" space ":" space string
integer ::= ("-"? integral-part) space
integral-part ::= [0-9] | [1-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
owner-kv ::= "\"owner\"" space ":" space string
root ::= "{" space owner-kv "," space amount-kv "," space currency-kv "}" space
space ::= " "?
string ::= "\"" char* "\"" space
