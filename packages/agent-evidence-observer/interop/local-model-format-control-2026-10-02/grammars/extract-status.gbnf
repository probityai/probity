char ::= [^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
root ::= "{" space ticket-kv "," space status-kv "}" space
space ::= " "?
status-kv ::= "\"status\"" space ":" space string
string ::= "\"" char* "\"" space
ticket-kv ::= "\"ticket\"" space ":" space string
