# Build context (the repository root) for packages/probity-ratchet/docker/demo.Dockerfile: only what the image
# installs. Nothing else, so no local state, record, key seed or capture can reach the image.
*
!pyproject.toml
!uv.lock
!packages/probity-ratchet/pyproject.toml
!packages/probity-ratchet/README.md
!packages/probity-ratchet/LICENSE
!packages/probity-ratchet/keys/ratchet-decisions.pub
!packages/probity-ratchet/src/
!packages/probity-ratchet/docker/demo/
!packages/probity-ratchet-cases/pyproject.toml
!packages/probity-ratchet-cases/README.md
!packages/probity-ratchet-cases/LICENSE
!packages/probity-ratchet-cases/src/
!packages/agent-evidence-verify/pyproject.toml
!packages/agent-evidence-verify/README.md
!packages/agent-evidence-verify/LICENSE
!packages/agent-evidence-verify/MANIFEST.in
!packages/agent-evidence-verify/src/
!packages/agent-evidence-verify/examples/source-coverage/
**/__pycache__
**/*.pyc
