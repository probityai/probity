  "oneOf": [
    {"$ref": "#/$defs/refundHandoffBundle"},
    {"$ref": "#/$defs/trustSnapshot"},
    {"$ref": "#/$defs/verifiedEvidenceEnvelope"},
    {"$ref": "#/$defs/admissionCommitEnvelope"},
    {"$ref": "#/$defs/admissionRecoveryEnvelope"},
    {"$ref": "#/$defs/approvalResolutionEnvelope"},
    {"$ref": "#/$defs/refundHandoffEnvelope"},
    {"$ref": "#/$defs/attemptEnvelope"},
    {"$ref": "#/$defs/effectEnvelope"},
    {"$ref": "#/$defs/outcomeEnvelope"},
    {"$ref": "#/$defs/reconciliationEnvelope"},
    {"$ref": "#/$defs/executionManifestEnvelope"},
    {"$ref": "#/$defs/providerSnapshotEnvelope"}
