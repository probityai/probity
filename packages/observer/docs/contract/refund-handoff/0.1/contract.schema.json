          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true,
          "description": "The reference verifier also requires ascending lexical order."
        }
      },
      "required": ["workflow_ids", "provider_ids", "decision_scopes"],
      "additionalProperties": false
    },
    "trustKey": {
      "type": "object",
      "properties": {
        "key_id": {"$ref": "#/$defs/identifier"},
        "principal_id": {"$ref": "#/$defs/identifier"},
        "role": {
          "enum": [
            "evidence-reader",
            "admission-authority",
            "recovery-observer",
            "handoff-issuer",
            "execution-observer",
            "effect-observer"
          ]
        },
        "public_key": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["active", "revoked"]},
        "not_before": {"$ref": "#/$defs/utcSecond"},
        "not_after": {"$ref": "#/$defs/utcSecond"},
        "revoked_at": {
          "oneOf": [
            {"$ref": "#/$defs/utcSecond"},
            {"type": "null"}
          ],
          "description": "Consumer-selected earliest instant when this key can neither issue a valid record nor authorize a dispatch; equality is revoked. Historical records issued before this instant remain authentic evidence."
        },
        "scope": {"$ref": "#/$defs/keyScope"}
      },
      "required": [
        "key_id",
        "principal_id",
        "role",
        "public_key",
        "status",
        "not_before",
        "not_after",
        "revoked_at",
        "scope"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
          "then": {"properties": {"revoked_at": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "revoked"}}, "required": ["status"]},
          "then": {"properties": {"revoked_at": {"$ref": "#/$defs/utcSecond"}}}
        }
      ]
    },
    "trustSnapshot": {
      "type": "object",
      "properties": {
        "profile": {"const": "https://probityai.github.io/agent-evidence-observer/contract/refund-handoff/0.1"},
        "schema": {"const": "refund-handoff/0.1"},
        "snapshot_id": {"$ref": "#/$defs/identifier"},
        "valid_from": {"$ref": "#/$defs/utcSecond"},
        "valid_until": {"$ref": "#/$defs/utcSecond"},
        "admission_checkpoint": {"$ref": "#/$defs/admissionCheckpoint"},
        "handoff_checkpoint": {"$ref": "#/$defs/handoffCheckpoint"},
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/trustKey"},
          "description": "Key identifiers and Ed25519 public-key bytes must each be unique."
        }
      },
      "required": [
        "profile",
        "schema",
        "snapshot_id",
        "valid_from",
        "valid_until",
        "admission_checkpoint",
        "handoff_checkpoint",
        "keys"
      ],
      "additionalProperties": false
    },
    "refundHandoffBundle": {
      "type": "object",
      "properties": {
        "profile": {"const": "https://probityai.github.io/agent-evidence-observer/contract/refund-handoff/0.1"},
        "schema": {"const": "refund-handoff/0.1"},
        "cutoff": {"$ref": "#/$defs/utcSecond"},
        "target": {"$ref": "#/$defs/target"},
        "inputs": {
          "type": "array",
          "maxItems": 512,
          "items": {"$ref": "#/$defs/verifiedEvidenceEnvelope"}
        },
        "admission": {
          "oneOf": [
            {"$ref": "#/$defs/admissionCommitEnvelope"},
            {"type": "null"}
          ]
        },
        "recovery": {
          "oneOf": [
            {"$ref": "#/$defs/admissionRecoveryEnvelope"},
            {"type": "null"}
          ]
        },
        "approval_resolutions": {
          "type": "array",
          "maxItems": 512,
          "items": {"$ref": "#/$defs/approvalResolutionEnvelope"}
        },
        "handoffs": {
          "type": "array",
          "maxItems": 512,
          "items": {"$ref": "#/$defs/refundHandoffEnvelope"}
        },
        "events": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/attemptEnvelope"},
              {"$ref": "#/$defs/effectEnvelope"},
              {"$ref": "#/$defs/outcomeEnvelope"},
              {"$ref": "#/$defs/reconciliationEnvelope"}
            ]
          }
        },
        "execution_manifest": {
          "oneOf": [
            {"$ref": "#/$defs/executionManifestEnvelope"},
            {"type": "null"}
          ]
        },
        "provider_snapshot": {
          "oneOf": [
            {"$ref": "#/$defs/providerSnapshotEnvelope"},
            {"type": "null"}
          ]
        }
      },
      "required": [
        "profile",
        "schema",
        "cutoff",
        "target",
        "inputs",
        "admission",
        "recovery",
        "approval_resolutions",
        "handoffs",
        "events",
        "execution_manifest",
        "provider_snapshot"
      ],
      "additionalProperties": false
    }
  }
