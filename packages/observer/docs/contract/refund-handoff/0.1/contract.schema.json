        "handoff_issuer": {"$ref": "#/$defs/identifier"},
        "provider_id": {"$ref": "#/$defs/identifier"},
        "tool": {"const": "refund"},
        "arguments": {"$ref": "#/$defs/refundArguments"}
      },
      "required": [
        "workflow_id",
        "decision_scope",
        "decision_issuer",
        "decision_id",
        "admission_authority_id",
        "handoff_issuer",
        "provider_id",
        "tool",
        "arguments"
      ],
      "additionalProperties": false
    },
