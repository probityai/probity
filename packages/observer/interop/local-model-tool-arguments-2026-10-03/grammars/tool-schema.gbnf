abstain-kv ::= "\"abstain\"" space ":" space boolean
arguments ::= "{" space arguments-key-kv "," space arguments-value-kv "}" space
arguments-key ::= string | null
arguments-key-kv ::= "\"key\"" space ":" space arguments-key
arguments-kv ::= "\"arguments\"" space ":" space arguments
arguments-value ::= integer | null
arguments-value-kv ::= "\"value\"" space ":" space arguments-value
boolean ::= ("true" | "false") space
char ::= [^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
integer ::= ("-"? integral-part) space
integral-part ::= [0-9] | [1-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
null ::= "null" space
root ::= "{" space tool-kv "," space arguments-kv "," space abstain-kv "}" space
space ::= " "?
string ::= "\"" char* "\"" space
tool ::= "\"write_record\"" | "\"inspect_record\"" | "\"none\""
tool-kv ::= "\"tool\"" space ":" space tool