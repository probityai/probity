{
  "name": "@probityai/records-verify",
  "version": "0.1.0",
  "description": "Offline verifier for probity-records journals: the same verdicts as the Python verifier, byte for byte, on the shared vectors",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Sankalp Gilda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/probityai/probity.git",
    "directory": "node/probity-records-verify"
  },
  "exports": {
    ".": "./dist/verify.js",
    "./delegation": "./dist/delegation.js",
    "./revocation": "./dist/revocation.js",
    "./verified": "./dist/verified.js"
  },
  "bin": {
    "probity-records-verify": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "@bufbuild/cel": "0.6.0",
    "jcs-admit": "0.1.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
